<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@color/rollcall_widget_surface">

    <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/widget_kicker" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_streak_title" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
    <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/widget_streak_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="—" android:textSize="42sp" android:textStyle="bold" />
    <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/widget_streak_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="-4dp" android:text="@string/widget_streak_empty" android:textSize="12sp" />
    <LinearLayout android:id="@+id/widget_streak_dots" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/streak_dot_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="·" android:textSize="18sp" />
        <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/streak_dot_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="·" android:textSize="18sp" />
        <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/streak_dot_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="·" android:textSize="18sp" />
        <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/streak_dot_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="·" android:textSize="18sp" />
        <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/streak_dot_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="·" android:textSize="18sp" />
        <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/streak_dot_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="·" android:textSize="18sp" />
        <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/streak_dot_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="·" android:textSize="18sp" />
    </LinearLayout>
    <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="@string/widget_waiting_for_sync" android:textSize="10sp" />
</LinearLayout>
