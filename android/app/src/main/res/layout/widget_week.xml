<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@color/rollcall_widget_surface">

    <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/widget_kicker" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_week_title" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
    <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/widget_week_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:text="Schedule at a glance" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/widget_week_next" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="Next class" android:ellipsize="end" android:maxLines="2" android:textSize="13sp" />
    <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/widget_week_agenda" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="See your upcoming classes here" android:ellipsize="end" android:maxLines="3" android:lineSpacingExtra="3dp" android:textSize="11sp" />
    <LinearLayout android:id="@+id/widget_week_days" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="9dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/week_day_0_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MON" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/week_day_0_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/week_day_1_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TUE" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/week_day_1_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/week_day_2_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WED" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/week_day_2_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/week_day_3_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="THU" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/week_day_3_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/week_day_4_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FRI" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/week_day_4_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/week_day_5_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SAT" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/week_day_5_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/week_day_6_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SUN" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/week_day_6_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:fontFamily="@font/jetbrains_mono_regular" android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="@string/widget_waiting_for_sync" android:textSize="10sp" />
</LinearLayout>
